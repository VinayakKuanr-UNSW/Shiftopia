# Stage 1: Build the static assets
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Vite inlines VITE_* at build time; .env files are excluded from the context
# (.dockerignore), so the values arrive as build args.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_OPTIMIZER_URL
ARG VITE_ML_URL
RUN test -n "$VITE_SUPABASE_URL" && test -n "$VITE_SUPABASE_ANON_KEY" \
    || (echo "VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY build args are required" >&2 && exit 1)

# Build step outputs static files to /app/dist
RUN npm run build

# Stage 2: Serve static assets with Nginx
FROM nginx:alpine

# Copy built static files to Nginx web root directory
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx config for single-page-app routing
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
